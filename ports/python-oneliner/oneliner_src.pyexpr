[
I:=__import__, Z:=I('zlib'), U:=I('unicodedata'), R:=I('re'), S:=I('sys'), J:=I('json'), FT:=I('functools'), IT:=I('itertools'),
b:=I('base64').b64decode('@@MODEL@@'),
M64:=(1<<64)-1,
V:=lambda p,n=0,s=0:(n|(b[p]&127)<<s,p+1) if b[p]<128 else V(p+1,n|(b[p]&127)<<s,s+7),
v1:=V(6), v2:=V(v1[1]), v3:=V(v2[1]), seed:=v1[0], mm:=v2[0], hp0:=v3[1], hn:=v3[0],
L:=Z.decompress(b[hp0:hp0+hn],-15).decode().split('\n'),
syms:=L[0].split('\x1f'),
PA:={k:int(x) for k,x in (y.split('=') for y in L[1][1:].split(',') if y)},
hasp:=len(L)>2 and L[2].startswith('@'),
praise:=[x for x in L[2][1:].split('\x1f') if x] if hasp else [],
T:=int.from_bytes(b[hp0+hn:hp0+hn+(mm+7)//8],'little'),
CAN:=lambda Ld:(it:=sorted(Ld.items(),key=lambda x:(x[1],x[0])), st:={'c':0,'p':None}, rev:={}, [(st.__setitem__('c',0 if st['p'] is None else (st['c']+1)<<(l-st['p'])), st.__setitem__('p',l), rev.__setitem__((st['c'],l),s)) for s,l in it], (rev,max(l for _,l in it),it[0][0]))[-1],
CTX:={c:CAN({syms[int(a)]:int(z) for a,z in (x.split(':') for x in r.split(','))}) for c,r in (l.split('\x1e') for l in L[3 if hasp else 2:])},
FNV:=lambda s:FT.reduce(lambda h,x:((h^x)*0x100000001B3)&M64,s.encode(),0xCBF29CE484222325),
SM:=lambda x:((y:=(x+0x9E3779B97F4A7C15)&M64),(y:=((y^(y>>30))*0xBF58476D1CE4E5B9)&M64),(y:=((y^(y>>27))*0x94D049BB133111EB)&M64),y^(y>>31))[-1],
Q:=lambda base,i:((h1:=SM(base^SM((seed<<16)^i))),(h2:=SM(h1^0xD1B54A32D192ED03)),bin((h2|1)&(T>>(h1%(mm-63)))&M64).count('1')&1)[-1],
DEC:=lambda c,bit:CTX[c][2] if CTX[c][1]==0 else next((CTX[c][0][(k,i+1)] for i in range(CTX[c][1]) if (k:=int(''.join(str(bit(j)) for j in range(i+1)),2),i+1) in CTX[c][0]),None),
SUBJ:=['國綜','國文','英語閱讀','英語聽力','英文','英語','數學A','數學B','數學','社會','自然','台灣價值'],
CN:={'〇':0,'零':0,'一':1,'二':2,'兩':2,'三':3,'四':4,'五':5,'六':6,'七':7,'八':8,'九':9},
C2I:=lambda s:int(s) if s.isdigit() else int(''.join(str(CN[c]) for c in s)) if not R.search('[十百]',s) else sum(FT.reduce(lambda st,ch:(st[0]+(st[1] or 1)*10,0) if ch=='十' else (st[0]+(st[1] or 1)*100,0) if ch=='百' else (st[0],CN[ch]),s,(0,0))),
NUM:=r'([0-9]+|[〇零一二兩三四五六七八九十百]+)',
PARSE:=lambda pr:((p:=U.normalize('NFKC',pr)),
  (tw:=(R.search(r'第\s*'+NUM+r'\s*題',p) or R.search(r'(?:題|#|no\.?)\s*'+NUM,p,R.I)) if R.search('台灣價值|臺灣價值',p) else None),
  ('TWV|2611|台灣價值|%d'%C2I(tw.group(1))) if tw else (
   (ex:='GSAT-makeup' if R.search('補考',p) and R.search('學測|學科能力',p) else 'GSAT' if R.search('學測|學科能力測驗|GSAT',p,R.I) else 'CAP' if R.search('會考|教育會考|CAP',p) else None),
   (y:=R.search(NUM+r'\s*(?:學年度|年度|年|學測|會考)',p)),
   (sj:=next((x for x in SUBJ if x in p),None)),
   (q:=R.search(r'第\s*'+NUM+r'\s*(?:-\s*([0-9]+))?\s*(?:題|格)',p) or R.search(r'(?:填充|選填)\s*(?:題)?\s*([A-J])(?![^\W])',p)),
   (sj:=('英語聽力' if '聽力' in p else '英語閱讀') if sj in ('英語','英文') and ex=='CAP' else sj),
   (sj:='英文' if sj=='英語' and ex!='CAP' else sj),
   (qq:=(str(C2I(q.group(1))) if not R.fullmatch('[A-J]',q.group(1)) else q.group(1))+('-'+q.group(2) if q.lastindex and q.lastindex>=2 and q.group(2) else '') if q else ''),
   (qq:='P2-'+qq if R.search('第二部分|第2部分',p) else qq),
   ('%s|%d|%s|%s'%(ex,C2I(y.group(1)),sj,qq)) if ex and y and sj and q else None)[-1])[-1],
CTXOF:=lambda k:((f:=k.split('|')[0].split('-')[0]), f if f in ('CAP','TWV') else f+'|'+{'國綜':'國文','數學A':'數學','數學B':'數學'}.get(k.split('|')[2],k.split('|')[2]))[-1],
HAN:=R.compile(r'[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff]'), SK_:=R.compile(r'[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaffa-z]'), OK_:=R.compile(r'[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaffa-z0-9]'),
LBL:=R.compile(r'(?m)[\(（]\s*([A-J]|[1-9])\s*[\)）]|(?<![^\n])[ \t]*([A-J])[ \t]*[\.．、\):：][ \t]'),
ANS:=R.compile(r'(?im)^[ \t]*(?:答案|答|解答|正解|answer|ans)[ \t]*[:：][ \t]*[^\s\u3400-\u9fff]{1,24}[ \t。.]*$'),
STA:=R.compile(r'\n|[0-9]{1,3}\s*[\.．、]\s|[:：]'),
HEAD:=R.compile(r'\s*(?:問題|題目|試題|question|q)\s*[0-9]*\s*[:：]',R.I),
NX:=R.compile(r'第\s*((?:P2-)?[0-9]{1,2}|[A-J])\s*[題格]'), NB:=R.compile(r'_{2,}\s*([0-9]{1,2})\s*_{2,}'),
NRM:=lambda s,keep:''.join(c for c in U.normalize('NFKC',s).lower() if keep.match(c)),
NST:=lambda s:(F:=NRM(s,SK_), w:=F[:64], ''.join(c for c in F if HAN.match(c)) if w and sum(1 for c in w if HAN.match(c))*2>=len(w) else F)[-1],
NOP:=lambda s:NRM(LBL.sub(' ',s),OK_),
MK:=lambda st,op:NST(st)[:48]+'|'+NOP(op)[:24],
SKY:=lambda st:'S:'+NST(st)[:48],
SPLIT:=lambda seg,r,lab:((fi:=next((i for i,(s,e,g) in enumerate(lab) if s>=r and g in ('A','1')),None)),
  (seg[r:],'') if fi is None else ((od:='ABCDEFGHIJ' if lab[fi][2]=='A' else '123456789'), (sq:=[]), (kk:=[0]),
   next((None for s,e,g in lab[fi:] if not ((kk[0]<len(od) and g==od[kk[0]] and (sq.append(s),kk.__setitem__(0,kk[0]+1))) or not (sq and g in od[:kk[0]]))),None),
   (nl:=seg.find('\n',sq[-1])), (seg[r:sq[0]], seg[sq[0]:len(seg) if nl<0 else nl]))[-1])[-1],
CANDS:=lambda prompt,Km:((raw:=U.normalize('NFKC',prompt).replace('\r\n','\n').replace('\r','\n')),
  (ends:=[x.end() for x in ANS.finditer(raw)]), (seg:=raw[ends[-1]:] if ends else raw),
  (lab:=[(x.start(),x.end(),x.group(1) or x.group(2)) for x in LBL.finditer(seg)]),
  (sts:=[r for r in sorted({0}|{x.end() for x in STA.finditer(seg) if x.end()<len(seg)}) if not HEAD.match(seg,r)]),
  (nums:=list(dict.fromkeys(x.group(1) for x in NX.finditer(seg))) or list(dict.fromkeys(x.group(1) for x in NB.finditer(seg)))),
  (nums:=nums[:20]), (out:=[]), (seen:=set()),
  [((sp:=SPLIT(seg,r,lab)), (key:=MK(*sp)), (sl:=len(key.split('|')[0])),
    None if key in seen else
    ((seen.add(key), out.extend(sk+'#'+n for sk in dict.fromkeys([key]+[MK(seg[r:r+x.start()],'') for x in R.finditer(r'\n',seg[r:r+200])]) if sk.split('|')[0] for n in nums)) if sl<Km and not sp[1] else
     (seen.add(key), out.extend(key+'#'+n for n in nums),
      ((sk:=SKY(sp[0])) not in seen and (seen.add(sk), out.append(sk))) if sl>=Km else None,
      out.append(key),
      [((k2:=MK(pc,'')), (k2l:=len(k2)-1),
        (seen.add(k2), out.append(k2)) if k2l>=Km and k2 not in seen else
        ([(seen.add(kk), out.append(kk)) for n in nums if (kk:=k2+'#'+n) not in seen] if 1<=k2l<Km else None),
        ((sk2:=SKY(pc)), (len(sk2)-2>=Km and sk2 not in seen and (seen.add(sk2), out.append(sk2)))))
       for pc in IT.takewhile(lambda pc:len(NRM(pc,SK_))<=112, (seg[r:r+x.start()] for x in R.finditer(r'\n',seg[r:])))] if not sp[1] else None)))
   for r in sts],
  out)[-1],
FP:=lambda tk,f:SM(FNV('FP|'+tk))>>(64-f),
GT:=lambda pr:((f:=PA['f']), (cs:=CANDS(pr,PA.get('Kmin',6))),
  (h:=next(((tk,bb) for tk in cs if (bb:=FNV('T|'+tk)) is not None and all(Q(bb,i)==(FP(tk,f)>>(f-1-i))&1 for i in range(f))),None)),
  {'text':DEC('TEXT',lambda i:Q(h[1],f+i)),'key':'T|'+h[0],'hit':True,'route':'text'} if h else
  ((tk:=cs[0] if cs else NST(pr) or pr[:64]), (bb:=FNV('T|'+tk)), (rn:=lambda off,nb:int(''.join(str(Q(bb,off+i)) for i in range(nb)) or '0',2)),
   (n:=1+rn(0,2)%2), (pk:=[]),
   next((None for t in range(8) if ((j:=rn(2+8*t,8)%len(praise)) in pk or pk.append(j)) and False or len(pk)==n),None),
   {'text':''.join(praise[j] for j in pk),'key':'T|'+tk,'hit':False,'route':'praise'})[-1])[-1],
CHAT:=lambda pr:(k:=PARSE(pr)) and CTXOF(k) in CTX and {'text':DEC(CTXOF(k),lambda i,bb=FNV(k):Q(bb,i)),'key':k,'hit':True,'route':'id'} or GT(pr),
print(J.dumps([CHAT(x) for x in J.load(S.stdin)],ensure_ascii=False)) if S.argv[1:2]==['--batch'] else print(CHAT(' '.join(S.argv[1:]))['text'])
]
